# Configuração do envio de e-mails (Vercel → Project → Settings → Environment Variables)
# Gere com: openssl rand -hex 32  (ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
VERIFY_SECRET=troque-por-uma-string-aleatoria-longa

# --- Opção A (recomendada p/ Gmail): SMTP do próprio Gmail ---
# Crie em: Conta Google → Segurança → Verificação em 2 etapas → Senhas de app
GMAIL_USER=seu.email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Opção B: Resend (https://resend.com) ---
# Se definida, tem prioridade sobre o Gmail
RESEND_API_KEY=re_xxx
RESEND_FROM=AeroSky Airlines <onboarding@resend.dev>
